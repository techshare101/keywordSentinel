# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (for AI summarization - reserved for premium features)
OPENAI_API_KEY=your_openai_api_key

# OpenRouter (for lead discovery - primary LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key

# Firecrawl (for web scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Resend (for email alerts)
RESEND_API_KEY=your_resend_api_key

# Crawl4AI Service (optional - enables crawler fallback for blocked sources)
# Deploy the service from services/crawler/ to Railway/Render, then set the URL
CRAWL4AI_SERVICE_URL=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret (for securing scan API)
CRON_SECRET_KEY=your_cron_secret_key
